# Staging compose example only. Use a secret-managed .env on the server.
BOOKING_DB_NAME=booking
BOOKING_DB_USER=booking
BOOKING_DB_PASSWORD=replace-with-a-long-random-password
BOOKING_DATABASE_URL=postgresql://booking:replace-with-a-long-random-password@booking-db:5432/booking
BOOKING_HOLD_SECRET=replace-with-at-least-32-random-characters
# Optional filesystem root for immutable published GTFS ZIP artifacts.
GTFS_ARTIFACT_DIR=/var/lib/booking/gtfs
# Optional in staging; required for production startup and real NOVA login.
AUTH_ISSUER=https://novaauth.niuautomations.com/api/auth
AUTH_CLIENT_ID=replace-with-registered-booking-client-id
AUTH_REDIRECT_URI=https://booking.niuautomations.com/auth/callback
# Optional resource audience for native NIU Driver access tokens.
# AUTH_ACCESS_TOKEN_AUDIENCE=registered-booking-api-audience
# Optional browser API origin. Leave blank when nginx serves /v1 on the same host.
NEXT_PUBLIC_API_BASE=
# Internal API origin used by the Next auth relay inside compose.
BOOKING_API_ORIGIN=http://booking-api:3100
